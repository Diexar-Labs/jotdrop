    <string name="toast_assets_folder_invalid">Ongeldige map. Gebruik een vault-relatief pad zoals assets.</string>

    <string name="test_button">Test: schrijf voorbeeldnotitie</string>
    <string name="test_note_body">Test vanuit JotDrop\n\nAls je dit ziet werkt \'t.</string>

    <string name="help_text">Tip: gebruik in elke app het deelmenu en kies "JotDrop". De gedeelde tekst belandt direct in de gekozen submap als markdown-bestand met tijdstempel.</string>

