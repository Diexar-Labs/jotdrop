<?xml version="1.0" encoding="utf-8"?>
<!-- A ticked item has a check mark and a line through its text, so it does not depend on colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_note_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_note_item_box"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_box" />

    <TextView
        android:id="@+id/widget_note_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#14213D"
        android:textSize="14sp" />
</LinearLayout>
