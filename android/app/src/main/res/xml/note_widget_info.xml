<?xml version="1.0" encoding="utf-8"?>
<!-- Updated by the app and the sync when a note changes, so the widget never wakes the phone by itself. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.diexar.keepcapture.NoteWidgetConfigureActivity"
    android:description="@string/widget_note_description"
    android:initialLayout="@layout/widget_note"
    android:minHeight="110dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/widget_note"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
