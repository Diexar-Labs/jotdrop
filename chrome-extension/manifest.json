{
  "manifest_version": 3,
  "name": "JotDrop Web Clipper",
  "version": "0.2.1",
  "description": "Clip any page into JotDrop, the Google Keep alternative: Markdown in Obsidian, or your end-to-end encrypted JotDrop Cloud.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://app.jotdrop.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clip to JotDrop",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html"
}
