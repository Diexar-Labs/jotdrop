    { "name": "a line break at the end stays", "text": "- [ ] a\n- [ ] b\n¦", "line": 0, "move": true, "expect": "- [ ] b\n- [x] a\n¦", "expectLine": 1 },
    { "name": "emoji before the caret", "text": "- [ ] 🎟️ a\n- [ ] b 😀¦", "line": 0, "move": true, "expect": "- [ ] b 😀¦\n- [x] 🎟️ a", "expectLine": 1 },
    { "name": "an empty task", "text": "- [ ]\n- [ ] b¦", "line": 0, "move": true, "expect": "- [ ] b¦\n- [x]", "expectLine": 1 },
    { "name": "a tab after the sign", "text": "-\t[ ]\ta\n- [ ] b¦", "line": 0, "move": false, "expect": "-\t[x]\ta\n- [ ] b¦", "expectLine": 0 },
    { "name": "every sign counts as a sibling", "text": "* [ ] a\n+ [ ] b¦", "line": 0, "move": true, "expect": "+ [ ] b¦\n* [x] a", "expectLine": 1 },
    { "name": "a selection over the task goes along", "text": "- [ ] ¦a¦\n- [ ] b", "line": 0, "move": true, "expect": "- [ ] b\n- [x] ¦a¦", "expectLine": 1 }
  ]
}
