      "config": { "provider": "ollama", "model": "llava" },
      "input": { "system": "S", "messages": [{ "role": "user", "text": "Read", "parts": [{ "kind": "pdf", "mime": "application/pdf", "name": "Policy.pdf", "data": "JVBERi0xLjQK" }] }] },
