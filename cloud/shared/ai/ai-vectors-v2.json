      "input": { "system": "S", "messages": [{ "role": "user", "text": "What is in these?", "parts": [{ "kind": "pdf", "mime": "application/pdf", "name": "Policy.pdf", "data": "JVBERi0xLjQK" }, { "kind": "audio", "mime": "audio/mp4", "name": "diexar-1.m4a", "data": "ZmFrZSBtNGE=" }] }] },
      "expect": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "method": "POST",
        "headers": { "Content-Type": "application/json", "Authorization": "Bearer sk-or-v1-test-key-0003", "HTTP-Referer": "https://jotdrop.net", "X-Title": "JotDrop" },
        "body": { "model": "google/gemini-3.5-flash", "messages": [
          { "role": "system", "content": "S" },
          { "role": "user", "content": [
            { "type": "file", "file": { "filename": "Policy.pdf", "file_data": "data:application/pdf;base64,JVBERi0xLjQK" } },
            { "type": "input_audio", "input_audio": { "data": "ZmFrZSBtNGE=", "format": "m4a" } },
            { "type": "text", "text": "What is in these?" }
          ] }
        ] }
      }
    },
    {
      "name": "openrouter: a model without file input gets the free PDF conversion, never the paid OCR by default",
      "config": { "provider": "openrouter", "key": "sk-or-v1-test-key-0003", "model": "mistralai/mistral-small", "inputs": ["text"] },
      "input": { "system": "S", "messages": [{ "role": "user", "text": "Due date?", "parts": [{ "kind": "pdf", "mime": "application/pdf", "name": "Invoice.pdf", "data": "JVBERi0xLjQK" }] }] },
      "expect": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "method": "POST",
        "headers": { "Content-Type": "application/json", "Authorization": "Bearer sk-or-v1-test-key-0003", "HTTP-Referer": "https://jotdrop.net", "X-Title": "JotDrop" },
        "body": { "model": "mistralai/mistral-small", "messages": [
          { "role": "system", "content": "S" },
          { "role": "user", "content": [
            { "type": "file", "file": { "filename": "Invoice.pdf", "file_data": "data:application/pdf;base64,JVBERi0xLjQK" } },
            { "type": "text", "text": "Due date?" }
