{
  "about": "Ask JotDrop version 2: files (photo, PDF, recording) to the user's own AI service, transcription, receipts. Played by parts.test.mjs, providers-v2.test.mjs, receipt.test.mjs and assistant-v2.test.mjs, and later by android/checks/AiCheck.kt. Version 1 stays in ai-vectors.json, unchanged. Keys are fake. A part with 'size' instead of 'data' gets that many zero bytes as base64 ('A' characters), so the limits can be tested without megabytes in this file.",
  "partRequests": [
    {
      "name": "anthropic: photo and PDF before the text",
      "config": { "provider": "anthropic", "key": "sk-ant-api03-test-key-0001", "model": "claude-haiku-5-5" },
      "input": { "system": "S", "messages": [{ "role": "user", "text": "What is on these?", "parts": [{ "kind": "image", "mime": "image/jpeg", "name": "Receipt.jpg", "data": "/9j/4AAQ" }, { "kind": "pdf", "mime": "application/pdf", "name": "Policy.pdf", "data": "JVBERi0xLjQK" }] }] },
      "expect": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": { "Content-Type": "application/json", "x-api-key": "sk-ant-api03-test-key-0001", "anthropic-version": "2026-10-21", "anthropic-dangerous-direct-browser-access": "true" },
        "body": { "model": "claude-haiku-5-5", "max_tokens": 16000, "system": "S", "messages": [{ "role": "user", "content": [
          { "type": "image", "source": { "type": "base64", "media_type": "image/jpeg", "data": "/9j/4AAQ" } },
          { "type": "document", "source": { "type": "base64", "media_type": "application/pdf", "data": "JVBERi0xLjQK" } },
          { "type": "text", "text": "What is on these?" }
        ] }] }
      }
    },
    {
      "name": "anthropic: only the message with files becomes a list; tool turns stay as in version 1",
      "config": { "provider": "anthropic", "key": "sk-ant-api03-test-key-0001", "model": "claude-haiku-5-5" },
      "input": { "system": "S", "messages": [
        { "role": "user", "text": "Tea?", "parts": [{ "kind": "image", "mime": "image/png", "name": "Shelf.png", "data": "iVBORw0K" }] },
        { "role": "assistant", "text": "", "toolCalls": [{ "id": "t1", "name": "search_notes", "input": { "query": "tea" } }] },
        { "role": "tool", "results": [{ "id": "t1", "name": "search_notes", "content": "No notes found." }] }
      ] },
      "expect": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": { "Content-Type": "application/json", "x-api-key": "sk-ant-api03-test-key-0001", "anthropic-version": "2026-10-21", "anthropic-dangerous-direct-browser-access": "true" },
        "body": { "model": "claude-haiku-5-5", "max_tokens": 16000, "system": "S", "messages": [
          { "role": "user", "content": [{ "type": "image", "source": { "type": "base64", "media_type": "image/png", "data": "iVBORw0K" } }, { "type": "text", "text": "Tea?" }] },
          { "role": "assistant", "content": [{ "type": "tool_use", "id": "t1", "name": "search_notes", "input": { "query": "tea" } }] },
          { "role": "user", "content": [{ "type": "tool_result", "tool_use_id": "t1", "content": "No notes found." }] }
        ] }
      }
    },
    {
      "name": "anthropic: a recording cannot go along",
      "config": { "provider": "anthropic", "key": "sk-ant-api03-test-key-0001" },
      "input": { "system": "S", "messages": [{ "role": "user", "text": "Summarize", "parts": [{ "kind": "audio", "mime": "audio/mp4", "name": "diexar-1.m4a", "data": "ZmFrZSBtNGE=" }] }] },
      "error": "unsupported_input"
