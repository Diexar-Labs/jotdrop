    { "provider": "nope", "model": "x", "expect": { "image": false, "pdf": false, "audio": false, "transcribe": false } }
  ],
  "explain": [
    { "provider": "anthropic", "kind": "audio", "use": "transcribe", "expect": "Claude cannot listen to recordings. Gemini and OpenAI can." },
    { "provider": "anthropic", "kind": "audio", "use": "ask", "expect": "Claude cannot listen to recordings. Gemini can." },
    { "provider": "openai", "kind": "audio", "use": "ask", "expect": "OpenAI cannot listen to recordings. Gemini can." },
    { "provider": "ollama", "kind": "pdf", "use": "ask", "expect": "This local model cannot read PDFs. Gemini, OpenAI, Claude and OpenRouter can." },
    { "provider": "openrouter", "kind": "image", "use": "ask", "expect": "This OpenRouter model cannot read photos. Gemini, OpenAI and Claude can." },
    { "provider": "custom", "kind": "audio", "use": "transcribe", "expect": "This address cannot listen to recordings. Gemini and OpenAI can." }
  ],
  "limits": {
    "constants": { "files": 4, "image": 4194304, "pdf": 12582912, "audio": 14680064, "total": 14680064 },
    "checks": [
      { "name": "a photo of exactly 4 MiB goes", "parts": [{ "kind": "image", "mime": "image/jpeg", "name": "a.jpg", "size": 4194304 }], "expect": { "bytes": 4194304 } },
      { "name": "a photo of 4 MiB and 1 byte does not", "parts": [{ "kind": "image", "mime": "image/jpeg", "name": "a.jpg", "size": 4194305 }], "error": "too_large" },
      { "name": "a PDF of exactly 12 MiB goes", "parts": [{ "kind": "pdf", "mime": "application/pdf", "name": "a.pdf", "size": 12582912 }], "expect": { "bytes": 12582912 } },
      { "name": "a PDF of 12 MiB and 1 byte does not", "parts": [{ "kind": "pdf", "mime": "application/pdf", "name": "a.pdf", "size": 12582913 }], "error": "too_large" },
      { "name": "a recording of exactly 14 MiB goes", "parts": [{ "kind": "audio", "mime": "audio/mp4", "name": "a.m4a", "size": 14680064 }], "expect": { "bytes": 14680064 } },
      { "name": "a recording of 14 MiB and 2 bytes does not", "parts": [{ "kind": "audio", "mime": "audio/mp4", "name": "a.m4a", "size": 14680066 }], "error": "too_large" },
      { "name": "a 4 MiB photo and an 11 MiB PDF are over 14 MiB together", "parts": [{ "kind": "image", "mime": "image/jpeg", "name": "a.jpg", "size": 4194304 }, { "kind": "pdf", "mime": "application/pdf", "name": "b.pdf", "size": 11534336 }], "error": "too_large" },
      { "name": "four small files go", "parts": [{ "kind": "image", "mime": "image/jpeg", "name": "1.jpg", "size": 10 }, { "kind": "image", "mime": "image/png", "name": "2.png", "size": 11 }, { "kind": "pdf", "mime": "application/pdf", "name": "3.pdf", "size": 12 }, { "kind": "audio", "mime": "audio/webm", "name": "4.webm", "size": 1 }], "expect": { "bytes": 34 } },
      { "name": "five small files do not", "parts": [{ "kind": "image", "mime": "image/jpeg", "name": "1.jpg", "size": 1 }, { "kind": "image", "mime": "image/jpeg", "name": "2.jpg", "size": 1 }, { "kind": "image", "mime": "image/jpeg", "name": "3.jpg", "size": 1 }, { "kind": "image", "mime": "image/jpeg", "name": "4.jpg", "size": 1 }, { "kind": "image", "mime": "image/jpeg", "name": "5.jpg", "size": 1 }], "error": "too_large" },
      { "name": "a video is not a kind JotDrop sends", "parts": [{ "kind": "video", "mime": "video/mp4", "name": "a.mp4", "size": 10 }], "error": "unsupported_input" },
      { "name": "the type must fit the kind", "parts": [{ "kind": "image", "mime": "application/pdf", "name": "a.pdf", "size": 10 }], "error": "unsupported_input" },
      { "name": "HEIC is turned into JPEG by the app first", "parts": [{ "kind": "image", "mime": "image/heic", "name": "a.heic", "size": 10 }], "error": "unsupported_input" },
      { "name": "base64 with a line break is the app's mistake", "parts": [{ "kind": "image", "mime": "image/jpeg", "name": "a.jpg", "data": "/9j/\n4AAQ" }], "error": "bad_request" },
      { "name": "an empty file does not go", "parts": [{ "kind": "pdf", "mime": "application/pdf", "name": "a.pdf", "data": "" }], "error": "bad_request" },
      { "name": "a recording to a service that cannot listen", "parts": [{ "kind": "audio", "mime": "audio/webm", "name": "a.webm", "size": 10 }], "caps": { "image": true, "pdf": true, "audio": false }, "error": "unsupported_input" },
      { "name": "unknown means try it", "parts": [{ "kind": "image", "mime": "image/jpeg", "name": "a.jpg", "size": 10 }], "caps": { "image": "unknown", "pdf": false, "audio": false }, "expect": { "bytes": 10 } },
      { "name": "padding is not counted as bytes", "parts": [{ "kind": "audio", "mime": "audio/mp4", "name": "a.m4a", "data": "ZmFrZSBtNGE=" }], "expect": { "bytes": 8 } }
    ]
  },
  "transcribe": [
