        "body": {
          "model": "gpt-6.1-terra",
          "messages": [
            { "role": "system", "content": "S" },
            { "role": "user", "content": "Open it" },
            { "role": "assistant", "content": "Opening.", "tool_calls": [{ "id": "call_2", "type": "function", "function": { "name": "open_note", "arguments": "{\"id\":\"n2\"}" } }] },
