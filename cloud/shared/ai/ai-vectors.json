{
  "about": "Ask JotDrop test vectors, shared by the JavaScript tests and the Android checks. Messages are in JotDrop's own form: {role:'user', text}, {role:'assistant', text, toolCalls, raw}, {role:'tool', results:[{id, name, content, isError}]}. A key in a vector is fake.",
  "tool": {
    "name": "open_note",
    "description": "Open a note for the user.",
    "mode": "read",
    "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false }
  },
  "requests": [
    {
      "name": "anthropic: first turn",
      "config": { "provider": "anthropic", "key": "sk-ant-api03-test-key-0001", "model": "claude-haiku-5-5" },
      "input": { "system": "S", "messages": [{ "role": "user", "text": "Hi" }] },
      "expect": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "headers": { "Content-Type": "application/json", "x-api-key": "sk-ant-api03-test-key-0001", "anthropic-version": "2026-10-21", "anthropic-dangerous-direct-browser-access": "true" },
        "body": {
          "model": "claude-haiku-5-5",
          "max_tokens": 16000,
          "system": "S",
          "messages": [{ "role": "user", "content": "Hi" }],
          "tools": [{ "name": "open_note", "description": "Open a note for the user.", "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false } }]
        }
      }
    },
    {
      "name": "anthropic: thinking and tool use go back unchanged, results in one user turn",
      "config": { "provider": "anthropic", "key": "sk-ant-api03-test-key-0001" },
      "input": {
        "system": "S",
        "messages": [
          { "role": "user", "text": "Open the boiler note" },
          { "role": "assistant", "text": "", "toolCalls": [{ "id": "toolu_1", "name": "open_note", "input": { "id": "n1" } }], "raw": [{ "type": "thinking", "thinking": "", "signature": "sig-1" }, { "type": "tool_use", "id": "toolu_1", "name": "open_note", "input": { "id": "n1" } }] },
          { "role": "tool", "results": [{ "id": "toolu_1", "name": "open_note", "content": "Opened." }] }
        ]
      },
      "expect": {
        "url": "https://api.anthropic.com/v1/messages",
