{
  "name": "jotdrop",
  "version": "0.20.15",
  "description": "A private, open-source Google Keep alternative for Obsidian: a trio of quick-capture card grid, companion Android app, and Chrome web clipper. Install all three for the full Keep experience.",
  "main": "main.js",
  "scripts": {
    "dev": "npm run verify:base && node esbuild.config.mjs",
    "build": "npm run verify:base && npm run build:plugin",
    "build:plugin": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "verify:base": "node scripts/verify-release-source.mjs base",
    "verify:deploy": "node scripts/verify-release-source.mjs deploy",
    "verify:release": "node scripts/verify-release-source.mjs release",
    "verify:tag": "node scripts/verify-release-tag.mjs",
    "check:list-preview": "node scripts/check-list-preview.cjs",
    "check:list-editor": "node scripts/check-list-editor.cjs",
    "check:list-editor-browser": "python scripts/check-list-editor-browser.py",
    "check:manual-order": "node scripts/check-manual-order.cjs",
    "check:statusbar-contrast": "node scripts/check-statusbar-contrast.cjs",
    "check:android-navigation": "node scripts/check-android-navigation.cjs",
    "check:android-startup": "node scripts/check-android-startup.cjs",
    "check:plugin-labels": "node scripts/check-plugin-labels.cjs",
    "check:hashtags": "node scripts/check-hashtags.cjs",
    "check:keep-import": "node scripts/check-keep-import.cjs",
    "check:mobile-keyboard": "node scripts/check-mobile-keyboard.cjs",
    "check:toolbar": "node scripts/check-toolbar-containment.cjs",
    "check:preview-fallback": "node scripts/check-preview-fallback.cjs",
    "check:recurrence": "node scripts/check-recurrence.cjs",
    "check:reminder-sound": "node scripts/check-reminder-sound.cjs",
    "check:web-clipper": "node scripts/check-web-clipper.mjs",
    "check:play-invite": "node scripts/check-play-invite.cjs",
    "check:transport-safety": "node scripts/check-transport-safety.cjs",
    "check:cloud": "node --test \"cloud/**/*.test.mjs\"",
    "check:cloud-browser": "python cloud/browser_check.py",
    "check:cloud-photo": "python cloud/photo_browser_check.py",
    "check:cloud-parity": "python cloud/parity_browser_check.py",
    "check:cloud-grid": "python cloud/grid_browser_check.py",
    "check:cloud-android": "node scripts/check-cloud-android.mjs",
    "check:cloud-account-android": "node scripts/check-cloud-account-android.mjs",
    "cloud:dev": "npm run verify:base && node cloud/server.mjs",
    "cloud:backup": "node cloud/backup.mjs",
    "build:cloud-clipper": "npm run verify:base && node scripts/build-cloud-clipper.mjs",
    "package:web-clipper": "node scripts/package-web-clipper.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "android:release": "node scripts/build-android-release.mjs",
    "android:test-release": "node scripts/build-android-release.mjs --test",
    "android:verify": "node scripts/verify-android-apk.mjs",
    "android:install": "node scripts/install-android-release.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "notes",
    "keep"
  ],
  "author": "Diexar Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diexar-Labs/jotdrop.git"
  },
  "bugs": {
    "url": "https://github.com/Diexar-Labs/jotdrop/issues"
  },
  "homepage": "https://github.com/Diexar-Labs/jotdrop#readme",
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/nld": "1.0.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "hash-wasm": "4.12.0",
    "obsidian": "latest",
    "tesseract.js": "7.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
